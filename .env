# Environment variables for Paint Can Interferometer project

# Interferometer configuration
NUMBER_OF_ANTENNAS=3 # Total number of antennas in the interferometer array

# Define the folder where data files are stored - use absolute path (e.g. /path/to/data)
DATA_FOLDER=mock_data # Path to the folder containing mock data files used for testing

FFT_SIZE=1024

# Data loading parameters
NUM_CHUNKS=5
TIME_SAMPLES=10000 # 10 thousand time samples - this would mean we load TIME_SAMPLES * NUM_CHUNKS * FFT_SIZE samples in total
